{
  "definitions": [
    {
      "title": "List Cards",
      "id": "list-cards",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 2
        },
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "List Cards",
              "filter": "list-cards"
            }
          }
        }
      }
    },
    {
      "title": "Card Item",
      "id": "list-card-item",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 2,
          "fields": [
            { "name": "theme", "selector": "div:nth-child(1) [data-theme]" },
            { "name": "text", "selector": "div:nth-child(2)" }
          ]
        },
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Card Item",
              "model": "list-card-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "list-card-item",
      "fields": [
        {
          "component": "select",
          "valueType": "string",
          "name": "theme",
          "value": "dark",
          "label": "Card Theme",
          "options": [
            { "name": "Dark Navy", "value": "dark" },
            { "name": "Light Grey", "value": "light" },
            { "name": "Blue Accent", "value": "blue" },
            { "name": "Light Fade", "value": "light-fade" }
          ]
        },
        {
          "component": "richtext",
          "name": "text",
          "value": "",
          "label": "Tag & Title Content",
          "valueType": "string"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "list-cards",
      "components": ["list-card-item"]
    }
  ]
}